# Gemini API key. Used only by the server (server.ts); never sent to the browser.
# Without a key the app still works: typed entries use the rule-based parser and photos use demo results.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: model name (default gemini-3.8-flash)
# GEMINI_MODEL="gemini-3.8-flash"

# Optional: prices in USD per million tokens, used by GET /api/usage to estimate cost per voice entry / shelf photo.
# GEMINI_INPUT_USD_PER_MTOK=""
# GEMINI_OUTPUT_USD_PER_MTOK=""

# Port for the server (default 3000)
# PORT=3000
